:root {
    --bg-color: #121214;
    --card-bg: #1e1e24;
    --text-color: #ffffff;
    --text-muted: #a0a0a5;
    --primary-color: #2480f0;
    --success-color: #2ec4b6;
    --danger-color: #e71d36;
    --border-color: #2d2d34;
}

body {
    margin: 0;
    padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-color);
    -webkit-font-smoothing: antialiased;
}

.app-container {
    padding: 16px;
    max-width: 480px;
    margin: 0 auto;
}

header {
    display: flex;
    flex-direction: column;
    margin-bottom: 20px;
}

header h2 {
    margin: 8px 0 0 0;
    font-size: 24px;
    font-weight: 700;
}

.user-info {
    font-size: 14px;
    color: var(--text-muted);
}

.stats-card {
    display: flex;
    justify-content: space-between;
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 24px;
}

.stat-item p {
    margin: 0 0 8px 0;
    font-size: 14px;
    color: var(--text-muted);
}

.stat-item h3 {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
}

.profit-text {
    color: var(--success-color);
}

.loss-text {
    color: var(--danger-color);
}

.trade-form {
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 24px;
}

.trade-form h3 {
    margin: 0 0 16px 0;
    font-size: 16px;
}

.form-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 12px;
}

.form-row {
    display: flex;
    gap: 12px;
}

.form-row .form-group {
    flex: 1;
}

label {
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 6px;
}

input, select {
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    color: var(--text-color);
    padding: 10px;
    font-size: 14px;
    outline: none;
    box-sizing: border-box;
    width: 100%;
}

input:focus, select:focus {
    border-color: var(--primary-color);
}

.btn-submit {
    width: 100%;
    background-color: var(--primary-color);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    margin-top: 8px;
}

.btn-submit:active {
    opacity: 0.9;
}

.trades-list-section h3 {
    margin: 0 0 12px 0;
    font-size: 16px;
}

.trades-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.empty-msg {
    text-align: center;
    color: var(--text-muted);
    font-size: 14px;
    padding: 20px 0;
}

.trade-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 12px;
}

.trade-info h4 {
    margin: 0 0 4px 0;
    font-size: 14px;
}

.trade-info span {
    font-size: 11px;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 600;
}

.badge-buy {
    background-color: rgba(46, 196, 182, 0.15);
    color: var(--success-color);
}

.badge-sell {
    background-color: rgba(231, 29, 54, 0.15);
    color: var(--danger-color);
}

.trade-result {
    font-weight: 600;
    font-size: 16px;
}

// Telegram Web App integratsiyasi
const tg = window.Telegram ? window.Telegram.WebApp : null;

if (tg) {
    tg.ready();
    tg.expand(); // Mini App-ni ekranda to'liq bo'yiga ochish
    
    // Foydalanuvchi ismini Telegram profildan tortib olish
    if (tg.initDataUnsafe && tg.initDataUnsafe.user) {
        document.getElementById('username').textContent = tg.initDataUnsafe.user.first_name;
    }
}

// Savdolar ro'yxatini brauzer xotirasida saqlash (Local Storage)
let trades = JSON.parse(localStorage.getItem('trading_trades')) || [];

const journalForm = document.getElementById('journal-form');
const tradesList = document.getElementById('trades-list');
const totalProfitEl = document.getElementById('total-profit');
const totalTradesEl = document.getElementById('total-trades');

function updateStats() {
    let totalProfit = 0;
    trades.forEach(trade => {
        totalProfit += parseFloat(trade.result);
    });

    totalTradesEl.textContent = trades.length;
    
    if (totalProfit >= 0) {
        totalProfitEl.textContent = `+${totalProfit.toFixed(2)}%`;
        totalProfitEl.className = 'profit-text';
    } else {
        totalProfitEl.textContent = `${totalProfit.toFixed(2)}%`;
        totalProfitEl.className = 'loss-text';
    }
}

function renderTrades() {
    tradesList.innerHTML = '';
    
    if (trades.length === 0) {
        tradesList.innerHTML = '<p class="empty-msg">Hozircha savdolar mavjud emas.</p>';
        return;
    }

    // Oxirgi qo'shilgan savdoni ro'yxat tepasida ko'rsatish
    [...trades].reverse().forEach(trade => {
        const item = document.createElement('div');
        item.className = 'trade-item';

        const isProfit = parseFloat(trade.result) >= 0;
        const resultClass = isProfit ? 'profit-text' : 'loss-text';
        const badgeClass = trade.direction === 'BUY' ? 'badge-buy' : 'badge-sell';

        item.innerHTML = `
            <div class="trade-info">
                <h4>${trade.pair.toUpperCase()}</h4>
                <span class="${badgeClass}">${trade.direction}</span>
            </div>
            <div class="trade-result ${resultClass}">
                ${isProfit ? '+' : ''}${trade.result}%
            </div>
        `;
        tradesList.appendChild(item);
    });
}

// Formani yuborish (Yangi savdo qo'shish)
journalForm.addEventListener('submit', function(e) {
    e.preventDefault();
    
    const pair = document.getElementById('pair').value;
    const direction = document.getElementById('direction').value;
    const result = document.getElementById('result').value;

    const newTrade = {
        id: Date.now(),
        pair,
        direction,
        result
    };

    trades.push(newTrade);
    localStorage.setItem('trading_trades', JSON.stringify(trades));
    
    journalForm.reset();
    updateStats();
    renderTrades();
});

// Boshlang'ich yuklanish
updateStats();
renderTrades();
